{
    "manifest_version": 3,
    "name": "Phishing Detection AI",
    "version": "1.1.0",
    "description": "AI-powered hybrid phishing detection using email, URL and behavioral analysis.",

    "permissions": [
        "tabs",
        "storage",
        "webNavigation",
        "scripting"
    ],

    "host_permissions": [
        "<all_urls>",
        "http://127.0.0.1:5000/*",
        "http://localhost:5000/*",
        "https://*.trycloudflare.com/*"
    ],

    "background": {
        "service_worker": "background.js"
    },

    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },

    "action": {
        "default_popup": "popup.html",
        "default_title": "Phishing Detection AI",
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },

    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "css": [
                "warning.css"
            ],
            "js": [
                "content.js",
                "warning.js"
            ],
            "run_at": "document_start"
        }
    ]
}