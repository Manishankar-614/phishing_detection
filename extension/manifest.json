{
    "manifest_version": 3,
    "name": "Phishing Detection AI",
    "version": "1.1.0",
    "description": "AI-powered hybrid phishing detection using email, URL and behavioral analysis.",

    "permissions": [
        "tabs",
        "storage",
        "webNavigation"
    ],

    "host_permissions": [
        "<all_urls>",
        "http://127.0.0.1:5000/*"
    ],

    "background": {
        "service_worker": "background.js"
    },

    "action": {
        "default_popup": "popup.html",
        "default_title": "Phishing Detection AI"
    },

    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "css": [
                "warning.css"
            ],
            "js": [
                "content.js",
                "warning.js"
            ],
            "run_at": "document_start"
        }
    ]
}